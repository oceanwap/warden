+/// EXPERIMENT (research/static-cpu-steering): steer new connections of the
+/// reuseport group to socket index `cpu % groups` (SO_ATTACH_REUSEPORT_CBPF),
+/// i.e. to the worker pinned to the CPU the connection came in on, when the
+/// workers bound in order and worker i runs on CPU i-1.
+#[cfg(target_os = "linux")]
+pub fn reuseport_cbpf_by_cpu(sock: BorrowedFd<'_>, groups: u32) -> io::Result<()> {
+    // ld [SKF_AD_OFF + SKF_AD_CPU]; alu mod #groups; ret a
+    let prog = [
+        libc::sock_filter { code: 0x20, jt: 0, jf: 0, k: (-0x1000i32 + 36) as u32 },
+        libc::sock_filter { code: 0x94, jt: 0, jf: 0, k: groups },
+        libc::sock_filter { code: 0x16, jt: 0, jf: 0, k: 0 },
+    ];
+    let fprog = libc::sock_fprog { len: prog.len() as u16, filter: prog.as_ptr() as *mut libc::sock_filter };
+    // SAFETY: a valid sock_fprog pointing at `prog`, both alive for the call.
+    check(unsafe {
+        libc::setsockopt(
+            sock.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_ATTACH_REUSEPORT_CBPF,
+            &fprog as *const libc::sock_fprog as *const libc::c_void,
+            std::mem::size_of::<libc::sock_fprog>() as libc::socklen_t,
+        )
+    })
+    .map(|_| ())
+}
+
 /// Not Linux: no TCP_DEFER_ACCEPT, so a no-op: accept(2) wakes on the bare
 /// handshake, which is just as correct, a little busier.
 #[cfg(not(target_os = "linux"))]
