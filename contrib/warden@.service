# systemd unit for Warden. One instance per app. `sudo warden startup` installs
# it (with this binary's path) and enables it for every saved app; by hand:
#   cp contrib/warden@.service /etc/systemd/system/
#   install -m 644 warden.example.toml /etc/warden/travelerwe-api.toml   # edit it
#   systemctl enable --now warden@travelerwe-api
#   systemctl reload warden@travelerwe-api     # safe-reload: canary, gates, rollback
#
# Set [control] socket = "/run/warden/<name>/control.sock" in the config
# (one runtime directory per instance: stopping one must not delete another's).

[Unit]
Description=Warden: %i
After=network-online.target
Wants=network-online.target
# Give up (and alert via OnFailure=, if set) only after 10 crashes in 60 s.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
# READY=1 is sent once every worker is listening.
Type=notify
NotifyAccess=main
User=www-data
Group=www-data
ExecStart=/usr/local/bin/warden start --config /etc/warden/%i.toml
# Blocks until the rollout finishes; a failed canary makes `systemctl reload` fail.
ExecReload=/usr/local/bin/warden safe-reload --config /etc/warden/%i.toml
# Also bounds `systemctl reload` (systemd applies the start timeout to
# reloads): leave room for canary_soak + gates for every worker.
TimeoutStartSec=600
Restart=always
# A Warden crash takes its workers down (they drain and exit ~0.7 s later);
# come back quickly. The outage is drain + RestartSec + app startup.
RestartSec=500ms
# Warden pings every second while its event loop keeps up; if it hangs
# (e.g. stdout stalled), systemd restarts it. Traffic is unaffected until then.
WatchdogSec=10

# Only Warden gets the first SIGTERM and orchestrates the drain; systemd
# SIGKILLs the whole cgroup if it is still there after TimeoutStopSec.
KillMode=mixed
KillSignal=SIGTERM
# grace_period (30 s) + margin
TimeoutStopSec=35

RuntimeDirectory=warden/%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
